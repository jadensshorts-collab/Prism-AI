{
  // A generated, stored deliverable (markdown) produced by the export pipeline
  // and persisted in Base44 file storage.
  "name": "Artifact",
  "type": "object",
  "title": "Artifact",
  "description": "A generated file deliverable — intelligence report, PRD, or builder prompt pack.",
  "properties": {
    "project_id": { "type": "string" },
    "kind": {
      "type": "string",
      "enum": ["report", "prd", "prompt-pack"],
      "description": "Which deliverable this file contains"
    },
    "title": { "type": "string" },
    "file_url": { "type": "string", "description": "Optional external URL, when file storage is used" },
    "filename": { "type": "string" },
    "size_bytes": { "type": "integer" },
    "summary": { "type": "string", "description": "Short human description of what's inside" },
    "content": {
      "type": "string",
      "description": "Rendered markdown chunk (field size is capped, so large deliverables span rows)"
    },
    "group_id": { "type": "string", "description": "Groups the chunks of one rendered deliverable" },
    "part": { "type": "integer", "default": 0 },
    "parts_total": { "type": "integer", "default": 1 }
  },
  "required": ["project_id", "kind"],
  "rls": {
    "create": true,
    "read": { "created_by": "{{user.email}}" },
    "update": { "created_by": "{{user.email}}" },
    "delete": { "created_by": "{{user.email}}" }
  }
}
